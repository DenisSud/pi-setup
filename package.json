{
  "name": "pi-setup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Denis's personal pi package: extensions and skills, installed by ~/.pi/agent.",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  },
  "dependencies": {
    "html-to-text": "10.0.1",
    "iconv-lite": "0.6.3",
    "imapflow": "2.2.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
