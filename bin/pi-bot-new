#!/usr/bin/env bash
# pi-bot-new — scaffold a bot agent dir at $PI_BOTS_HOME/<name>.
#
#   pi-bot new <name>
#
# Creates the standard bot shape: persona (APPEND_SYSTEM.md), skills/,
# extensions/, settings.json (base package + this bot's memory clone),
# package.json (base as a file: dependency, for `pi-bots/...` imports),
# symlinks to the shared auth/models/security/trust files, its own clone of
# the memory repo, and a local git repo.
#
# Environment:
#   PI_BOTS_HOME        bots root                (default ~/Bots)
#   PI_SHARED_AGENT_DIR shared pi agent dir      (default ~/.pi/agent)
#   PI_MEMORY_REMOTE    memory repo to clone     (default: origin of $PI_SHARED_AGENT_DIR/memory)
set -euo pipefail

bots_home="${PI_BOTS_HOME:-$HOME/Bots}"
shared="${PI_SHARED_AGENT_DIR:-$HOME/.pi/agent}"
base_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

usage() {
  echo "usage: pi-bot new <name>" >&2
  echo "  name: lowercase letters, digits, dashes" >&2
}

name="${1:-}"
if [[ -z "$name" ]]; then usage; exit 2; fi
if [[ ! "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
  echo "pi-bot-new: invalid name '$name'" >&2; usage; exit 2
fi

bot_dir="$bots_home/$name"
if [[ -e "$bot_dir" ]]; then
  echo "pi-bot-new: $bot_dir already exists" >&2
  exit 1
fi

command -v jq >/dev/null 2>&1 || { echo "pi-bot-new: jq is required" >&2; exit 1; }

# ── skeleton ─────────────────────────────────────────────────────────
mkdir -p "$bot_dir/skills" "$bot_dir/extensions" "$bot_dir/sessions" "$bot_dir/notes"

cat > "$bot_dir/SOUL.md" <<EOF
# SOUL — $name

You are the **$name bot**.

<!-- Voice, values, personality. Human-authored; the agent never edits this
file. The job and the boundaries live in APPEND_SYSTEM.md. -->

## Voice

## Values
EOF

cat > "$bot_dir/APPEND_SYSTEM.md" <<EOF
# $name bot

You are the **$name bot**.

## Job

<!-- What this bot owns, in one or two sentences. -->

## Boundaries

<!-- What it must not do, and where it hands off. -->
EOF

# ── settings.json: base package + shared git packages ────────────────
base_rel="$(realpath --relative-to="$bot_dir" "$base_dir")"
memory_remote="${PI_MEMORY_REMOTE:-$(git -C "$shared/memory" remote get-url origin 2>/dev/null || true)}"

# Git-sourced packages from the shared settings (the memory extension) are part
# of the standard bot shape; local paths there are the base itself.
shared_git="$(jq -r '.packages[]? | select(startswith("ssh://") or startswith("https://") or startswith("git@"))' \
  "$shared/settings.json" 2>/dev/null || true)"
packages="$(jq -cn --arg base "$base_rel" --args '[$base] + $ARGS.positional' $shared_git)"

jq --argjson packages "$packages" \
   '.packages = $packages' "$base_dir/settings.json" > "$bot_dir/settings.json"

# ── package.json: base as a file: dependency ─────────────────────────
cat > "$bot_dir/package.json" <<EOF
{
  "name": "pi-bot-$name",
  "version": "0.1.0",
  "private": true,
  "description": "$name bot — pi agent dir (see APPEND_SYSTEM.md)",
  "dependencies": {
    "pi-bots": "file:$base_rel"
  }
}
EOF

if command -v bun >/dev/null 2>&1; then
  (cd "$bot_dir" && bun install --silent >/dev/null 2>&1) \
    || echo "pi-bot-new: bun install failed (extensions importing 'pi-bots/...' will not resolve)" >&2
elif command -v npm >/dev/null 2>&1; then
  (cd "$bot_dir" && npm install --no-audit --no-fund --silent >/dev/null 2>&1) \
    || echo "pi-bot-new: npm install failed (extensions importing 'pi-bots/...' will not resolve)" >&2
else
  echo "pi-bot-new: no bun or npm found — skipping install" >&2
fi

# ── shared plumbing (symlinks) ───────────────────────────────────────
# models-store.json is the model-catalog cache. A bot without it tries to
# refetch the catalog, and that endpoint can fail (403) — sharing the locked
# cache file keeps bots working offline and off that path.
# security.json is not here: the security extension reads it from the absolute
# ~/.pi/agent/security.json (or $PI_SECURITY_CONFIG), so profiles are shared
# with no per-bot copy.
# Linked unconditionally: a dangling link starts working as soon as the shared
# file appears (e.g. after the first login in the base agent).
unlinked=()
for f in auth.json models.json models-store.json trust.json; do
  ln -sfn "$shared/$f" "$bot_dir/$f"
  [[ -f "$shared/$f" ]] || unlinked+=("$f")
done
if [[ ${#unlinked[@]} -gt 0 ]]; then
  echo "pi-bot-new: not present in $shared yet (linked anyway): ${unlinked[*]}" >&2
fi

# ── memory: one clone per bot, same remote as the shared one ─────────
if [[ -n "$memory_remote" ]]; then
  if git clone --quiet "$memory_remote" "$bot_dir/memory"; then
    echo "cloned memory: $memory_remote"
  else
    echo "pi-bot-new: memory clone failed — the bot will fall back to $shared/memory" >&2
  fi
else
  echo "pi-bot-new: no memory remote found — skipping clone" >&2
fi

# ── local git repo ───────────────────────────────────────────────────
cat > "$bot_dir/.gitignore" <<'EOF'
node_modules/
sessions/
memory/
git/
pi-debug.log
*.log
.pi/
EOF

if command -v git >/dev/null 2>&1 && [[ ! -d "$bot_dir/.git" ]]; then
  git -C "$bot_dir" init -q -b main
  git -C "$bot_dir" add -A
  git -C "$bot_dir" commit -q -m "Scaffold $name bot"
fi

echo "created $bot_dir"
echo
echo "next:"
echo "  1. edit $bot_dir/APPEND_SYSTEM.md (job + boundaries)"
echo "  2. add skills/ and extensions/, then commit"
echo "  3. run it: pi-bot $name"
