#!/usr/bin/env sh
# pi-bot — attach to and manage Denis's bots.
#
#   pi-bot attach <bot> [--new]   attach (starts the bot's server if needed)
#   pi-bot resolve <bot>          ensure the server, resolve the session
#   pi-bot list                   list bots
#   pi-bot new <name>             scaffold a new bot
#   pi-bot <bot> [--new]          same as attach
#
# A bot is a complete pi agent dir at $PI_BOTS_HOME/<name> (default ~/Bots).
# It runs as a pi server; this script only boots the TypeScript CLI in
# packages/connector. See packages/connector/README.md for the launcher spec.
set -eu

self="$(readlink -f "$0")"
root="$(dirname "$(dirname "$self")")"
exec node "$root/packages/connector/src/bin.ts" "$@"
